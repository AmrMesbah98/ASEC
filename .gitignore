# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# CocoaPods — regenerated by `pod install`
/ios/Pods/
/macos/Pods/
/ios/.symlinks/
/macos/.symlinks/

# Flutter tool output per platform
**/Flutter/ephemeral/
**/flutter/ephemeral/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/macos/Flutter/Generated.xcconfig
/macos/Flutter/flutter_export_environment.sh
/macos/Flutter/GeneratedPluginRegistrant.swift

# Xcode user state
**/xcuserdata/
**/*.xcworkspace/xcuserdata/

# Signing / secrets — never commit these
*.jks
*.keystore
key.properties
.env
*.p8
*.p12
*.mobileprovision
*serviceAccount*.json
*-adminsdk-*.json

# Files delivered into the folder by the Claude desktop app
/Claude outputs/

# one-off admin scripts
tool/node_modules/
tool/package*.json
tool/videos_default_backup.json
*service-account*.json

# npm install for tool/ scripts, if run from the project root
/node_modules/
/package.json
/package-lock.json
